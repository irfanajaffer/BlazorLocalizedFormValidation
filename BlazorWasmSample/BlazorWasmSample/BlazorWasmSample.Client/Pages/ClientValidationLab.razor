@page "/client-validation"
@rendermode InteractiveWebAssembly
@using BlazorLocalizedFormValidation.Shared
@using System.Globalization

<PageTitle>Interactive WebAssembly validation</PageTitle>

<div class="validation-lab">
    <h1>Interactive WebAssembly localized validation</h1>
    <p>
        This page uses the same shared <code>ContactModel</code> and resource
        set as the Static SSR sample so both required modes can be compared
        directly.
    </p>

    <div class="validation-evidence" aria-label="Current test context">
        <span class="evidence-badge">Interactive WebAssembly</span>
        <span class="evidence-badge">@CultureInfo.CurrentUICulture.Name</span>
    </div>

    <nav aria-label="Validation culture">
        <a href="/client-validation?culture=fr-FR&amp;ui-culture=fr-FR" data-enhance-nav="false">French (France)</a>
        <span aria-hidden="true"> | </span>
        <a href="/client-validation?culture=de-DE&amp;ui-culture=de-DE" data-enhance-nav="false">German (Germany)</a>
    </nav>

    <EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="scenario-grid">
            <ClientFieldScenario Title="Name" Help="German intentionally omits ContactModel_Name_RequiredAttribute_Error so the field falls back to the framework-required text.">
                <label for="contact-name" class="form-label">Name</label>
                <InputText id="contact-name" class="form-control" @bind-Value="Model.Name" />
                <ValidationMessage For="() => Model.Name" />
            </ClientFieldScenario>

            <ClientFieldScenario Title="Email" Help="EmailRequired remains translated in both French and German.">
                <label for="contact-email" class="form-label">Email</label>
                <InputText id="contact-email" class="form-control" @bind-Value="Model.Email" />
                <ValidationMessage For="() => Model.Email" />
            </ClientFieldScenario>
        </div>

        <button type="submit" class="btn btn-primary">Validate</button>
    </EditForm>

    @if (submitted)
    {
        <p role="status" class="alert alert-success mt-3">Interactive WebAssembly validation passed.</p>
    }
</div>

@code {
    private ContactModel Model { get; } = new();
    private bool submitted;

    private void HandleValidSubmit()
    {
        submitted = true;
    }
}
