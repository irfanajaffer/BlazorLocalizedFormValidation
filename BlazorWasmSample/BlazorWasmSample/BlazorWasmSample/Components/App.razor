@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorWasmSample.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="blazorCulture.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        // Resolve the requested/persisted culture *before* the WebAssembly runtime
        // boots so it starts with the correct culture instead of booting with the
        // default culture and re-rendering after CultureInfo is set (flicker).
        const applicationCulture = window.blazorCulture.get();
        Blazor.start({
            webAssembly: {
                applicationCulture: applicationCulture
            }
        });
    </script>
</body>

</html>
