@page "/validation"
@using BlazorLocalizedFormValidation.Shared
@using System.Globalization

<PageTitle>Static SSR localized validation</PageTitle>

<div class="validation-lab">
<h1>Static SSR localized validation</h1>

<p>
    This page uses the shared <code>ContactModel</code> required by the issue.
    Leave both fields empty and submit to compare the conventional Name
    validation with the explicit Email validation.
</p>

<div class="validation-evidence" aria-label="Current test context">
    <span class="evidence-badge" data-testid="render-mode">Static SSR</span>
    <span class="evidence-badge" data-testid="current-culture">@CultureInfo.CurrentUICulture.Name</span>
</div>

<nav aria-label="Validation culture">
    <a href="/validation?culture=fr-FR&amp;ui-culture=fr-FR">French (France)</a>
    <span aria-hidden="true"> | </span>
    <a href="/validation?culture=de-DE&amp;ui-culture=de-DE">German (Germany)</a>
</nav>

<EditForm Model="Model" FormName="contact-validation" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="scenario-grid">
        <section class="scenario-card" data-testid="name-scenario">
            <h2 class="h5">Name</h2>
            <p class="scenario-help">
                Conventional key: <code>ContactModel_Name_RequiredAttribute_Error</code>.
                The German resource intentionally omits this key so the message
                falls back to the framework-required text.
            </p>
            <label for="contact-name" class="form-label">Name</label>
            <InputText id="contact-name" class="form-control" @bind-Value="Model.Name" />
            <ValidationMessage For="() => Model.Name" />
        </section>

        <section class="scenario-card" data-testid="email-scenario">
            <h2 class="h5">Email</h2>
            <p class="scenario-help">
                Explicit key: <code>EmailRequired</code>. This translation is
                present in both French and German.
            </p>
            <label for="contact-email" class="form-label">Email</label>
            <InputText id="contact-email" class="form-control" @bind-Value="Model.Email" />
            <ValidationMessage For="() => Model.Email" />
        </section>
    </div>

    <button type="submit" class="btn btn-primary">Validate</button>
</EditForm>

@if (submitted)
{
    <p role="status" class="alert alert-success mt-3" data-testid="submit-result">
        The localized validation probe submitted successfully.
    </p>
}
</div>

@code {
    [SupplyParameterFromForm(FormName = "contact-validation")]
    private ContactModel? FormModel { get; set; }

    private bool submitted;

    private ContactModel Model => FormModel ??= new();

    private void HandleValidSubmit()
    {
        submitted = true;
    }
}
